/// Market premiums and claims paid by month (August and September 2022 are empty: not published)
table market_monthly
	lineageTag: 46582ded-a8eb-45de-aa13-4a34c7c2f0ce

	/// Market premiums by month, million AZN
	measure 'Monthly Premiums (mln AZN)' = DIVIDE ( SUM ( market_monthly[premiums] ), 1000 )
		formatString: #,0.0
		displayFolder: Market
		lineageTag: 3a1dc8f4-04bf-4318-983b-e874081f2ec1

	/// Market claims paid by month, million AZN
	measure 'Monthly Claims (mln AZN)' = DIVIDE ( SUM ( market_monthly[claims_paid] ), 1000 )
		formatString: #,0.0
		displayFolder: Market
		lineageTag: 93d91eda-8046-4d9f-9225-7b4f385933cc

	column month_start
		dataType: dateTime
		formatString: yyyy-mm-dd
		lineageTag: cb5b1d89-cda3-4bc4-abcb-4c8cb3b3dcce
		summarizeBy: none
		sourceColumn: month_start

		annotation UnderlyingDateTimeDataType = Date

	column year
		dataType: int64
		formatString: 0
		lineageTag: 7594f9ae-50c7-4a05-a20f-3d404d0beaef
		summarizeBy: none
		sourceColumn: year

	column month
		dataType: int64
		formatString: 0
		lineageTag: 0d36c6b5-206a-470c-adb9-95c3b8e8ed00
		summarizeBy: none
		sourceColumn: month

	column premiums
		dataType: double
		formatString: #,0.0
		lineageTag: 4ae41c7b-e686-4d2f-98cd-b4d31b56d2b8
		summarizeBy: sum
		sourceColumn: premiums

	column claims_paid
		dataType: double
		formatString: #,0.0
		lineageTag: fae08ef1-ebd8-403e-989c-d10e54b5f203
		summarizeBy: sum
		sourceColumn: claims_paid

	column payout_ratio
		dataType: double
		isHidden
		formatString: 0.0%
		lineageTag: b05fe929-38bf-48cf-ae61-40ec89cf31ad
		summarizeBy: none
		sourceColumn: payout_ratio

	partition market_monthly = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "\market_monthly.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    #"Changed Type" = Table.TransformColumnTypes(#"Promoted Headers", {{"month_start", type date}, {"year", Int64.Type}, {"month", Int64.Type}, {"premiums", type number}, {"claims_paid", type number}, {"payout_ratio", type number}}, "en-US")
				in
				    #"Changed Type"

